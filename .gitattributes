# Auto detect text files and perform LF normalization
* text=auto

# Java sources
*.java text diff=java

# JavaScript sources
*.js text
*.vue text
*.json text

# SQL files
*.sql text

# Markdown files
*.md text

# Shell scripts
*.sh text eol=lf

# Windows scripts
*.bat text eol=crlf
*.cmd text eol=crlf

# Configuration files
*.yml text
*.yaml text
*.properties text
*.xml text

# Binary files
*.jar binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
