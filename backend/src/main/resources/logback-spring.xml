<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <!-- 日志配置属性 -->
    <property name="LOG_HOME" value="${LOG_PATH:-logs}"/>
    <property name="APP_NAME" value="ai-atg"/>
    
    <!-- 日志格式 -->
    <property name="LOG_PATTERN" 
              value="%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %-5level %logger{50} - %msg%n"/>
    
    <!-- 控制台日志格式（普通Logback不支持%clr颜色） -->
    <property name="CONSOLE_LOG_PATTERN" 
              value="%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %-5level %logger{50} - %msg%n"/>
    
    <!-- ============================== -->
    <!-- 控制台输出配置 -->
    <!-- ============================== -->
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>${CONSOLE_LOG_PATTERN}</pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>
    
    <!-- ============================== -->
    <!-- INFO级别日志文件配置 -->
    <!-- ============================== -->
    <appender name="INFO_FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <!-- 当前日志文件 -->
        <file>${LOG_HOME}/${APP_NAME}-info.log</file>
        
        <!-- 日志格式 -->
        <encoder>
            <pattern>${LOG_PATTERN}</pattern>
            <charset>UTF-8</charset>
        </encoder>
        
        <!-- 滚动策略：按时间和大小 -->
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <!-- 归档文件命名模式：日期 + 索引 -->
            <fileNamePattern>${LOG_HOME}/history/${APP_NAME}-info-%d{yyyy-MM-dd}.%i.log.gz</fileNamePattern>
            
            <!-- 单个文件最大大小：100MB -->
            <maxFileSize>100MB</maxFileSize>
            
            <!-- 保留天数：30天 -->
            <maxHistory>30</maxHistory>
            
            <!-- 所有归档文件总大小：10GB（超过则删除最旧的） -->
            <totalSizeCap>10GB</totalSizeCap>
        </rollingPolicy>
        
        <!-- 只记录INFO及以上级别，但排除ERROR -->
        <filter class="ch.qos.logback.classic.filter.LevelFilter">
            <level>ERROR</level>
            <onMatch>DENY</onMatch>
            <onMismatch>NEUTRAL</onMismatch>
        </filter>
        <filter class="ch.qos.logback.classic.filter.ThresholdFilter">
            <level>INFO</level>
        </filter>
    </appender>
    
    <!-- ============================== -->
    <!-- ERROR级别日志文件配置 -->
    <!-- ============================== -->
    <appender name="ERROR_FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <!-- 当前日志文件 -->
        <file>${LOG_HOME}/${APP_NAME}-error.log</file>
        
        <!-- 日志格式 -->
        <encoder>
            <pattern>${LOG_PATTERN}</pattern>
            <charset>UTF-8</charset>
        </encoder>
        
        <!-- 滚动策略：按时间和大小 -->
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <!-- 归档文件命名模式 -->
            <fileNamePattern>${LOG_HOME}/history/${APP_NAME}-error-%d{yyyy-MM-dd}.%i.log.gz</fileNamePattern>
            
            <!-- 单个文件最大大小：50MB -->
            <maxFileSize>50MB</maxFileSize>
            
            <!-- 保留天数：90天（错误日志保留更久） -->
            <maxHistory>90</maxHistory>
            
            <!-- 所有归档文件总大小：5GB -->
            <totalSizeCap>5GB</totalSizeCap>
        </rollingPolicy>
        
        <!-- 只记录ERROR级别 -->
        <filter class="ch.qos.logback.classic.filter.ThresholdFilter">
            <level>ERROR</level>
        </filter>
    </appender>
    
    <!-- ============================== -->
    <!-- 全量日志文件配置（可选） -->
    <!-- ============================== -->
    <appender name="ALL_FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <!-- 当前日志文件 -->
        <file>${LOG_HOME}/${APP_NAME}-all.log</file>
        
        <!-- 日志格式 -->
        <encoder>
            <pattern>${LOG_PATTERN}</pattern>
            <charset>UTF-8</charset>
        </encoder>
        
        <!-- 滚动策略 -->
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${LOG_HOME}/history/${APP_NAME}-all-%d{yyyy-MM-dd}.%i.log.gz</fileNamePattern>
            
            <!-- 单个文件最大大小：200MB -->
            <maxFileSize>200MB</maxFileSize>
            
            <!-- 保留天数：7天（全量日志不需要保留太久） -->
            <maxHistory>7</maxHistory>
            
            <!-- 总大小限制：5GB -->
            <totalSizeCap>5GB</totalSizeCap>
        </rollingPolicy>
    </appender>
    
    <!-- ============================== -->
    <!-- 异步日志配置（提升性能） -->
    <!-- ============================== -->
    <appender name="ASYNC_INFO" class="ch.qos.logback.classic.AsyncAppender">
        <!-- 队列大小 -->
        <queueSize>512</queueSize>
        <!-- 队列满时不丢弃日志 -->
        <discardingThreshold>0</discardingThreshold>
        <!-- 引用INFO日志 -->
        <appender-ref ref="INFO_FILE"/>
    </appender>
    
    <appender name="ASYNC_ERROR" class="ch.qos.logback.classic.AsyncAppender">
        <queueSize>512</queueSize>
        <discardingThreshold>0</discardingThreshold>
        <appender-ref ref="ERROR_FILE"/>
    </appender>
    
    <!-- ============================== -->
    <!-- 特定包的日志级别配置 -->
    <!-- ============================== -->
    
    <!-- 应用包日志 -->
    <logger name="com.aiatg" level="INFO" additivity="false">
        <appender-ref ref="CONSOLE"/>
        <appender-ref ref="ASYNC_INFO"/>
        <appender-ref ref="ASYNC_ERROR"/>
    </logger>
    
    <!-- Spring框架日志 -->
    <logger name="org.springframework" level="INFO"/>
    
    <!-- MyBatis日志 -->
    <logger name="com.baomidou.mybatisplus" level="INFO"/>
    <logger name="com.aiatg.mapper" level="DEBUG"/>
    
    <!-- SQL日志（开发环境可开启DEBUG查看SQL） -->
    <logger name="org.apache.ibatis" level="INFO"/>
    
    <!-- Redis日志 -->
    <logger name="org.springframework.data.redis" level="INFO"/>
    
    <!-- HTTP请求日志 -->
    <logger name="org.springframework.web" level="INFO"/>
    
    <!-- ============================== -->
    <!-- 根日志配置 -->
    <!-- ============================== -->
    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
        <appender-ref ref="ASYNC_INFO"/>
        <appender-ref ref="ASYNC_ERROR"/>
        <appender-ref ref="ALL_FILE"/>
    </root>
    
    <!-- ============================== -->
    <!-- 环境配置（可根据profile调整） -->
    <!-- ============================== -->
    
    <!-- 开发环境 -->
    <springProfile name="dev">
        <logger name="com.aiatg" level="DEBUG"/>
        <logger name="com.aiatg.mapper" level="DEBUG"/>
    </springProfile>
    
    <!-- 生产环境 -->
    <springProfile name="prod">
        <logger name="com.aiatg" level="INFO"/>
        <logger name="com.aiatg.mapper" level="INFO"/>
    </springProfile>
    
</configuration>
